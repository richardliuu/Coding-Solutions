class Solution:
    def halvesAreAlike(self, s: str) -> bool:
        s1 = s[:len(s)//2]
        s2 = s[len(s)//2:]
        vowels = "aeiou"
        s1_count = 0
        s2_count = 0 

        for i in s1:
            if i.lower() in vowels:
                s1_count += 1

        for i in s2:
            if i.lower() in vowels:
                s2_count += 1

        return s1_count == s2_count
        
