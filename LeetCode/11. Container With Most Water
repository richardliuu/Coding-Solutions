class Solution:
    def maxArea(self, height: List[int]) -> int:
        maximum = 0 
        left = 0
        right = len(height) - 1

        while left <= right:
            distance = right - left
            water = min(height[left], height[right]) * (distance)
            maximum = max(maximum, water)
            
            print("m", min(height[left], height[right]))
            print(distance)
            
            # Optimize pointers  
            if height[left] < height[right]:
                left += 1
            else: 
                right -= 1
            
        return maximum

        
