class MyQueue:
    """
    queue (FIFO)
    stack (LIFO)
    """
    def __init__(self):
        self.in_stack = []
        self.out_stack = []

    def push(self, x: int) -> None:
        self.in_stack.append(x)

    def pop(self) -> int:
        # If the stack is empty 
        if not self.out_stack:
            # While there are still elements
            while self.in_stack:
                # Add the element that was deleted from the in stack
                self.out_stack.append(self.in_stack.pop())
            # Return the removed element 
        return self.out_stack.pop()
            
    def peek(self) -> int:
        # Check if the outstack is empty  
        if not self.out_stack:
            # While there are still elements
            while self.in_stack:
                # Perform LIFO to FIFO switch
                self.out_stack.append(self.in_stack.pop())
        # Return switch
        return self.out_stack[-1]

    def empty(self) -> bool:
        return not self.in_stack and not self.out_stack
