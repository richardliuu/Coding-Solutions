class Solution:
    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:
        """
        Anagram is if all the sorted characters are the same

        Search for where the group for the anagram belongs, else
        create a new group for it. 
        """

        elements = []

        for word in strs:
            # Track whether an item has been placed 
            grouped = False 
            
            # Search through the elements 
            for group in elements:
                if sorted(word) == sorted(group[0]):
                    group.append(word)
                    grouped = True 
                    break

            # if there is no group 
            if not grouped:
                # Create a group for the element in the list 
                elements.append([word])

        return elements 

        
