class Solution:
    def findMaxK(self, nums: List[int]) -> int:
        left = 0
        right = len(nums) - 1

        nums.sort()
        largest = float("-inf")

        while left < right:
            # Will cancel out 
            if nums[left] + nums[right] == 0:
                largest = max(largest, nums[right])
                left += 1 
                right -=1
            elif nums[left] + nums[right] < 0:
                left += 1
            else:
                right -= 1

        if largest == float("-inf"):
            return -1

        return largest

        
