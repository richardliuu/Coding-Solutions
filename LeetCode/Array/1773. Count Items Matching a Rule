class Solution:
    def countMatches(self, items: List[List[str]], ruleKey: str, ruleValue: str) -> int:
        count = 0 

        if ruleKey == "type":
            ruleKey = 0
        elif ruleKey == "color":
            ruleKey = 1
        elif ruleKey == "name":
            ruleKey = 2

        for info in items:
            if info[ruleKey] == ruleValue:
                count += 1 

        return count
        
