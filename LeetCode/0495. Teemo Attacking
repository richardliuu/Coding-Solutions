class Solution:
    def findPoisonedDuration(self, timeSeries: List[int], duration: int) -> int:
        time = duration

        for i in range(len(timeSeries)-1):
            if timeSeries[i] + duration > timeSeries[i+1]:
                time += timeSeries[i+1] - timeSeries[i]
            else:
                time += duration

        return time
        
