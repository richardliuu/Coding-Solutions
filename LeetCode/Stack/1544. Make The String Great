class Solution:
    def makeGood(self, s: str) -> str:
        stack = []

        for char in s:
            # The difference between lower and upper case chars is 32
            # Means that they are adjacent
            if stack and abs(ord(char) - ord(stack[-1])) == 32:
                stack.pop()
            else:
                stack.append(char)

        return "".join(stack)
