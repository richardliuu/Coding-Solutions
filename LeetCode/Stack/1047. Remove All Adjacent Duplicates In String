class Solution:
    def removeDuplicates(self, s: str) -> str:
        """
        Use a stack to process letters and pop
        """
        stack = []

        for char in s:
            stack.append(char)
            if len(stack) >= 2 and stack[-2] == stack[-1]:
                stack.pop()
                stack.pop()

        return "".join(stack)
