class Solution:
    def finalPrices(self, prices: List[int]) -> List[int]:
        stack = []

        for i in range(len(prices)):
            while stack and prices[stack[-1]] >= prices[i]:
                # The index through returning stack.pop
                idx = stack.pop()

                # Discount
                prices[idx] -= prices[i]

            stack.append(i)

        return prices
                

        
        
