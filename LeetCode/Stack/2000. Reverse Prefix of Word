class Solution:
    def reversePrefix(self, word: str, ch: str) -> str:
        stack = [] 
        pointer = 0

        for char in word:
            if char == ch:
                stack.append(char)
                stack = stack[-1::-1]    
                return "".join(stack) + "".join(word[pointer+1:])

            stack.append(char)
            pointer += 1

        return "".join(stack)
        
