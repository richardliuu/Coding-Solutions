# Heap Solution

class Solution:
    def topKFrequent(self, nums: List[int], k: int) -> List[int]:
        counts = Counter(nums) 
        heap = []
        res = []

        # Create the heap
        for num, count in counts.items():
            heapq.heappush(heap, (-count, num))
        
        for i in range(k):
            res.append(heapq.heappop(heap)[1])
        
        return res



        
