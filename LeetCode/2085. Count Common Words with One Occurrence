class Solution:
    def countWords(self, words1: List[str], words2: List[str]) -> int:
        w1_count = Counter(words1)
        w2_count = Counter(words2)
        total = 0

        for i in w1_count:
            if w1_count[i] == 1 and w2_count[i] == 1:
                total += 1

        return total 
