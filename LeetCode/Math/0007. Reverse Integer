class Solution:
    def reverse(self, x: int) -> int:
        """
        321 % * 100 = 21 
        21 % 10 = 1
        """
        sign = -1 if x < 0 else 1
        res = 0
        x = abs(x)

        while x > 0:
            digit = x % 10
            res = (res*10) + digit
            x //= 10

        if res > 2**31 - 1:
            return 0 
        elif res < -2 ** 31:
            return 0 

        return res * sign

