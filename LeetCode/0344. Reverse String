class Solution:
    def reverseString(self, s: List[str]) -> None:
        """
        Do not return anything, modify s in-place instead.
        """

        right = len(s) - 1

        for left in range(len(s) // 2):
            right_copy = s[right]
            left_copy = s[left]
            s[left] = right_copy
            s[right] = left_copy
            right -= 1


        
