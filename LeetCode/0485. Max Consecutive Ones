class Solution:
    def findMaxConsecutiveOnes(self, nums: List[int]) -> int:
        maximum = 0 
        streak = 0

        for i in range(len(nums)):
            if nums[i] == 1:
                streak += 1

                if streak > maximum:
                    maximum = streak
                    
            elif nums[i] == 0:
                streak = 0 

        return maximum 

        
