class Solution:
    def plusOne(self, digits: List[int]) -> List[int]:
        # Loop backwards
        for i in range(len(digits) -1, -1, -1):
          # Check if we need to carry numbers over 
            if digits[i] < 9:
                # Add 1 if not 9
                digits[i] += 1
                return digits
            # If 9, set to 0 
            digits[i] = 0 
            
        return [1] + digits
