# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:

        node = ListNode()
        cur = node 

        # While elements exist
        while list1 and list2:
            if list1.val < list2.val:
                cur.next = list1
                cur = list1
                
                # Set the next to the next node
                list1 = list1.next
            else:
                cur.next = list2
                cur = list2
                list2 = list2.next

        if list1:
            cur.next = list1
        else:
            cur.next = list2

        return node.next
        
