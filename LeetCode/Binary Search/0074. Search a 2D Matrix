class Solution:
    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:
        """
        We can perform a binary search within the matrices, and isolate where target should be 
        """
        matrix_left = 0 
        matrix_right = len(matrix) - 1 
        target_matrix = 0

        # Binary search to find the target array 
        while matrix_left <= matrix_right:
            # Reduce to the middle of the left and right 
            mid = (matrix_left + matrix_right) // 2
            # Search
            if target >= matrix[mid][0] and target <= matrix[mid][-1]:
                target_matrix = mid 
                break
            elif matrix[mid][0] > target:
                matrix_right = mid - 1
            else:
                matrix_left = mid + 1 

        left = 0
        right = len(matrix[target_matrix]) - 1

        # Second binary search in the target matrix
        while left <= right:
            mid = (left + right) // 2
            if matrix[target_matrix][mid] == target:
                return True
            elif target < matrix[target_matrix][mid]:
                right = mid - 1
            else:
                left = mid + 1

        return False 
        
