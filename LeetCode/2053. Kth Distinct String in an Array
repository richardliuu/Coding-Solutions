class Solution:
    def kthDistinct(self, arr: List[str], k: int) -> str:
        distinct = [] 
        counts = Counter(arr)

        for i in arr:
            if counts[i] == 1:
                distinct.append(i)

        print(distinct)

        if k <= len(distinct):
            return distinct[k - 1]
        else:
            return ""
