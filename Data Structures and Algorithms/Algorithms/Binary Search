
def binary_search(self, nums: List[int], target: int) -> int:
    # Get the length of the nums 
    length = len(nums)

    left = 0
    right = length - 1

    while left <= right:
        mid = (left + right) // 2
        if target < nums[mid]:
            right = mid - 1
        elif target > nums[mid]:
            left = mid + 1 
        else:
            return mid 

    return -1 
                  

                 
        
