import numpy as np

def descriptive_statistics(data: list | np.ndarray) -> dict:
    """
    Calculate various descriptive statistics metrics for a given dataset.
    
    Args:
        data: List or numpy array of numerical values
    
    Returns:
        Dictionary containing mean, median, mode, variance, standard deviation,
        percentiles (25th, 50th, 75th), and interquartile range (IQR)
    """
    stats = {
        "mean": 0, 
        "median": 0,
        "mode": 0,
        "variance": 0,
        "standard_deviation": 0,
        "25th_percentile": 0,
        "50th_percentile": 0,
        "75th_percentile": 0,
        "interquartile_range": 0
    }

    stats["mean"] = np.mean(data)
    stats["median"] = np.median(data)
    
    # Get counts 
    values, counts = np.unique(data, return_counts=True)
    frequencies = dict(zip(values, counts))
    stats["mode"] = max(frequencies, key=frequencies.get)

    stats["variance"] = np.var(data)
    stats["standard_deviation"] = stats["variance"] ** (1/2)
    stats["25th_percentile"] = np.quantile(data, 0.25)
    stats["50th_percentile"] = np.quantile(data, 0.50)
    stats["75th_percentile"] = np.quantile(data, 0.75)
    stats["interquartile_range"] = stats["75th_percentile"] - stats["25th_percentile"]

    return stats
