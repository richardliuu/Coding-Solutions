import numpy as np

def reshape_matrix(a: list[list[int|float]], new_shape: tuple[int, int]) -> list[list[int|float]]:
	# Write your code here and return a python list after reshaping by using numpy's tolist() method
	arr = []

	counts = sum([len(row) for row in a])	
	if counts != np.prod(new_shape):
		return []

	# Flatten to a 1D array so you can slice 
	a = np.array(a).flatten()

	for i in range(0, len(a), new_shape[1]):
		start = i 
		end = i + new_shape[1]
		arr.append(list(a[start:end]))

	return arr
