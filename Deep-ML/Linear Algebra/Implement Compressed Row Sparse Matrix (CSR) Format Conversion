import numpy as np

def compressed_row_sparse_matrix(dense_matrix):
	"""
	Convert a dense matrix to its Compressed Row Sparse (CSR) representation.

	:param dense_matrix: 2D list representing a dense matrix
	:return: A tuple containing (values array, column indices array, row pointer array)
	"""
	values_arr = []
	column_arr = []
	row_arr = [0]

	# get values
	for row_idx in range(len(dense_matrix)):
		for col_idx in range(len(dense_matrix[row_idx])):
			if dense_matrix[row_idx][col_idx] != 0:
				values_arr.append(dense_matrix[row_idx][col_idx])
				column_arr.append(col_idx)
		
		row_arr.append(len(values_arr))


	return values_arr, column_arr, row_arr 

