
import numpy as np

def rmse(y_true, y_pred):
	y_true = np.asarray(y_true).reshape(-1)
	y_pred = np.asarray(y_pred).reshape(-1)

	n = len(y_true)
	sum_error = 0

	for i in range(len(y_true)):
		sum_error += (y_true[i] - y_pred[i]) ** 2
	
	rmse_res = ((1/n) * sum_error) ** 0.5

	return round(rmse_res,3)
