num_t = int(input())

"""
Find the perimeter and area 
"""

for i in range(num_t):
    ax, ay, bx, by, cx, cy = map(int, input().split(" "))

    # Perimeter 
    ab = ((ax-bx)**2 + (ay-by)**2)**0.5
    ac = ((ax-cx)**2 + (ay-cy)**2)**0.5
    cb = ((cx-bx)**2 + (cy-by)**2)**0.5

    perimeter = ab + ac + cb 

    s = perimeter / 2
    # Area 
    area = (s*(s-ab)*(s-ac)*(s-cb))**0.5

    print(f"{area:.2f} {perimeter:.2f}")
    
