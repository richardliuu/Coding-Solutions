import sys 

n, m = map(int, sys.stdin.readline().split())
road = []
bessie = [] 
infraction = 0 

for i in range(n):
    length, limit = map(int, sys.stdin.readline().split())
    road += [limit] * length

for j in range(m):
    distance, speed = map(int, sys.stdin.readline().split()) 
    bessie += [speed] * distance

for i in range(100):
    infraction = max(infraction, bessie[i] - road[i])

sys.stdout.write(str(infraction))

